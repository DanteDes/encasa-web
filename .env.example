# Genera un secret con: openssl rand -base64 32
AUTH_SECRET='tu-secret-aqui'

# URL del frontend en producción (sin trailing slash)
NEXTAUTH_URL=https://tu-proyecto.vercel.app

# Credenciales de Google OAuth
# Obtenerlas en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend API URL (Railway)
# NEXT_PUBLIC_API_URL se usa en el cliente (browser)
# BACKEND_URL se usa en el servidor (Next.js server-side, auth callbacks)
# Ambos deben apuntar a la misma URL de Railway en producción
NEXT_PUBLIC_API_URL=https://tu-proyecto.railway.app
BACKEND_URL=https://tu-proyecto.railway.app

# Cloudinary: subida de fotos adjuntas al pedir un turno (Solicitar turno).
# No son secretos — el cloud name y el preset "unsigned" son públicos por diseño,
# el navegador sube directo a Cloudinary sin pasar por nuestro backend.
# Cloud name: Dashboard de Cloudinary, arriba a la izquierda.
# Upload preset: Settings > Upload > Upload presets > crear uno con Signing Mode = Unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset
